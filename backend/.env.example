# SERVER
PORT=3000

# DATABASE
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# LOG DIRECTORY
LOG_BASE_PATH=./dashboard-logs

# TIKTOK
TIKTOK_IMAGE=your-registry/tiktok:your-version
TIKTOK_CONFIG_PATH=/path/to/config-vpn-tiktok.toml

# YOUTUBE
YOUTUBE_IMAGE=your-registry/youtube:your-version
YOUTUBE_CONFIG_PATH=/path/to/config-vpn-youtube.toml

# NEWS
NEWS_IMAGE=your-registry/universal-news:your-version
NEWS_CONFIG_PATH=/path/to/config-vpn-news.toml

# FACEBOOK
FACEBOOK_IMAGE=your-registry/facebook:your-version
FACEBOOK_CONFIG_PATH=/path/to/config-vpn-facebook.toml

# INSTAGRAM
INSTAGRAM_IMAGE=your-registry/instagram:your-version
INSTAGRAM_CONFIG_PATH=/path/to/config-vpn-instagram.toml

# TWITTER
TWITTER_IMAGE=your-registry/twitter:your-version
TWITTER_CONFIG_PATH=/path/to/config-vpn-twitter.toml

# THREADS
THREADS_IMAGE=your-registry/threads:your-version
THREADS_CONFIG_PATH=/path/to/config-threads.toml
